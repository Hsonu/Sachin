<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".SplashActivity">

    <!-- Logo Image -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        android:alpha="0" />

    <!-- App Name -->
    <TextView
        android:id="@+id/splashAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="serif"
        android:letterSpacing="0.08"
        android:text="HIMALAYAN KULFI"
        android:textColor="#D9A52A"
        android:textSize="28sp"
        android:textStyle="bold"
        android:alpha="0" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:text="Premium Handcrafted Kulfi &amp; Desserts"
        android:textColor="#C4B873"
        android:textSize="15sp"
        android:alpha="0" />

    <!-- Bottom loading indicator -->
    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="48dp"
        android:indeterminate="true"
        android:indeterminateTint="#D9A52A" />

</LinearLayout>
